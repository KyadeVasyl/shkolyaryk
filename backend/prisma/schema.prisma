generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum WeekType {
  ALL
  ODD
  EVEN
}

enum Subgroup {
  ALL
  ONE
  TWO
}

model Group {
  id                String    @id @default(uuid())
  name              String
  viewToken         String    @unique
  editTokenHash     String
  createdAt         DateTime  @default(now())
  scheduleUpdatedAt DateTime  @default(now())
  oddWeekAnchor     DateTime?
  lessons           Lesson[]
}

model Lesson {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  subject   String
  teacher   String?
  location  String?
  link      String?
  weekType  WeekType @default(ALL)
  subgroup  Subgroup @default(ALL)
  note      String?

  @@index([groupId])
}